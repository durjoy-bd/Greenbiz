# Supply through your shell/service manager; no automatic .env loading.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_ORIGIN=https://greenbiz.example.com
DATABASE_PATH=/data/greenbiz.sqlite
# Behind Caddy, nginx or Cloudflare: trust one proxy hop so limits and sessions see real clients.
TRUST_PROXY=1
# Email for sign-up confirmation, password resets and invitations (or set it in Admin → Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GreenBiz <no-reply@greenbiz.example.com>"
# New accounts must confirm their email before signing in (needs email delivery).
REQUIRE_EMAIL_VERIFICATION=true
# Days to keep activity events (30-3650). The audit log is always kept.
ACTIVITY_RETENTION_DAYS=365
# Optional server-side AI. Never put these in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# Deployment compose configuration (use your own real domain).
GREENBIZ_DOMAIN=greenbiz.example.com
# Release signing values come from your secure signing environment:
# GREENBIZ_KEYSTORE=/private/greenbiz-release.jks
# GREENBIZ_STORE_PASSWORD=
# GREENBIZ_KEY_ALIAS=
# GREENBIZ_KEY_PASSWORD=
