{
  "name": "greenbiz",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "lint": "eslint src shared server --max-warnings 0",
    "postinstall": "node scripts/patch-capacitor.cjs",
    "build:server": "esbuild server/index.ts server/admin.ts server/backup.ts --bundle --platform=node --format=esm --packages=external --outdir=server-dist && node scripts/copy-migrations.cjs",
    "server:prod": "node server-dist/index.js",
    "test:ui": "playwright test",
    "build:server:standalone": "esbuild server/index.ts server/admin.ts server/backup.ts --bundle --platform=node --target=node24 --format=esm --outdir=deploy/vps/build/server --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" && node scripts/copy-migrations.cjs deploy/vps/build/server",
    "package:vps": "npm run build && npm run build:server:standalone && node scripts/package-site.cjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
