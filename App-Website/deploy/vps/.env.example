# Copy to .env on the server. Never commit the real file.
# The address people type in the browser, exactly (no trailing slash).
PUBLIC_ORIGIN=http://203.0.113.10:8790
# Required only while serving over plain HTTP by IP. Remove once HTTPS is on.
ALLOW_INSECURE_HTTP=true
GREENBIZ_PORT=8790
GREENBIZ_VERSION=2.4.0
# Email for confirmations, password resets and invitations. You can also set this later
# in the admin panel (Settings), which takes precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# New accounts confirm their email before signing in. Needs email delivery.
REQUIRE_EMAIL_VERIFICATION=true
ACTIVITY_RETENTION_DAYS=365
# Optional server-side AI for the web portal.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
