# Plain HTTP on the container's port 80 (published on the host as GREENBIZ_PORT).
# For HTTPS with a domain, replace ":80" with the domain name and publish 80/443.
{
	admin off
	auto_https off
}
:80 {
	encode zstd gzip
	# /admin opens the admin panel (the app uses hash routes).
	redir /admin /#/admin 302
	redir /admin/ /#/admin 302
	handle /api/* {
		reverse_proxy api:8787
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), payment=()"
		-Server
	}
}
