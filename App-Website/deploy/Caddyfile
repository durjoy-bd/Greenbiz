{$GREENBIZ_DOMAIN} {
    encode gzip
    # /admin opens the admin panel (the app uses hash routes).
    redir /admin /#/admin 302
    redir /admin/ /#/admin 302
    handle /api/* {
        reverse_proxy api:8787
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
